---
import MainLayout from '../layouts/MainLayout.astro';
import { currentAdmin } from '../lib/auth';
import { getSettings, siteSettingsSchema } from '../db/repository';
let admin = null;
let settings = siteSettingsSchema.parse({});
let error = '';
try { admin = await currentAdmin(Astro.cookies); settings = await getSettings(); } catch { error = '数据库不可用，请检查部署配置'; }
---
<MainLayout title="管理后台" settings={settings} admin>
  <link rel="stylesheet" href="/admin.css" /><link rel="stylesheet" href="/admin-refresh.css" />
  {error ? <main class="login-wrap"><div class="login-card"><h1>暂时无法连接</h1><p>{error}</p><p>请检查 MySQL 和环境变量。</p></div></main> : !admin ? <main class="login-wrap"><form id="login-form" class="login-card"><img class="admin-logo" src="/images/brand-lockup-black.png" alt="LLLimit 导航站" /><h1>管理后台</h1><p>请输入管理员账号继续。</p><label>账号<input name="username" autocomplete="username" required /></label><label>密码<input name="password" type="password" autocomplete="current-password" required /></label><button type="submit">登录</button><small id="login-message" role="alert"></small></form></main> : <div class="admin-shell">
    <aside class="admin-side"><div class="admin-brand"><img class="admin-logo" src="/images/brand-lockup-white.png" alt="LLLimit 导航站" /></div><nav id="admin-nav"><button data-view="dashboard" class="selected">仪表盘</button><button data-view="sites">网址管理</button><button data-view="categories">分类管理</button><button data-view="import">快速导入</button><button data-view="stats">访问统计</button><button data-view="settings">网站设置</button><button data-view="security">安全设置</button></nav><button id="logout-button" class="logout">退出登录</button></aside>
    <main class="admin-main"><header class="admin-top"><button id="admin-menu" aria-label="打开菜单">☰</button><span id="view-title">仪表盘</span><a href="/" target="_blank">查看网站 ↗</a></header><div id="admin-message" role="status"></div>
      <section data-panel="dashboard"><div class="panel-head"><div><h1>仪表盘</h1><p>网站运营概览</p></div></div><div id="summary-cards" class="summary-grid"></div><div class="admin-grid"><div class="panel"><h2>浏览与点击趋势</h2><div id="dashboard-chart" class="chart"></div></div><div class="panel"><h2>热门网站</h2><div id="popular-list"></div></div></div></section>
      <section data-panel="sites" hidden><div class="panel-head"><div><h1>网址管理</h1><p>添加、编辑与整理网站</p></div><button id="site-add" class="primary">添加网址</button></div><div class="toolbar"><input id="site-query" type="search" placeholder="搜索名称或网址" /><select id="site-category-filter"><option value="">全部分类</option></select><select id="site-status-filter"><option value="">全部状态</option><option value="1">已启用</option><option value="0">已禁用</option></select><select id="site-icon-filter" aria-label="按网址图标筛选" title="只筛选网址，不更改分类"><option value="">全部网址图标</option><option value="default">使用默认图标的网址</option><option value="custom">有独立图标的网址</option></select><select id="site-sort"><option value="order">手动排序</option><option value="created">最新添加</option><option value="clicks">访问最多</option><option value="title">按名称</option></select><button id="site-filter">筛选</button></div><div class="toolbar"><label class="checkline"><input type="checkbox" id="site-select-all" /> 全选本页</label><button id="bulk-enable">批量启用</button><button id="bulk-disable">批量禁用</button><button id="bulk-delete" class="danger">批量删除</button><button id="site-temporary-edit" type="button" aria-pressed="false" aria-controls="site-list" aria-describedby="site-temporary-edit-help">临时编辑</button></div><p id="site-temporary-edit-help" class="temporary-edit-help">名称过长、编辑或删除按钮被挤出时，可开启「临时编辑」：临时缩短列表显示并将操作按钮独立成行，仅影响本次页面显示，原始名称不变。</p><div id="site-list" class="admin-list"></div><div class="pagination"><button id="site-prev">上一页</button><span id="site-page"></span><button id="site-next">下一页</button></div></section>
      <section data-panel="categories" hidden><div class="panel-head"><div><h1>分类管理</h1><p>一级分类显示在侧边栏，二级分类显示在对应分区顶部。</p></div><button id="category-add" class="primary">添加一级分类</button></div><div id="category-list" class="admin-list"></div></section>
      <section data-panel="import" hidden><div class="panel-head"><div><h1>快速导入</h1><p>粘贴网址，或导入 JSON / CSV</p></div></div><div class="panel form-stack"><label>网址列表，每行一个<textarea id="import-urls" rows="8" placeholder="https://github.com&#10;https://openai.com"></textarea></label><div class="toolbar"><label>分类<select id="import-category"></select></label><label>标签<input id="import-tags" placeholder="逗号分隔" /></label><label class="checkline"><input id="import-featured" type="checkbox" /> 推荐</label><label class="checkline"><input id="import-enabled" type="checkbox" checked /> 启用</label></div><div class="toolbar"><button id="parse-import">逐个解析网址</button><button id="save-import" class="primary" disabled>保存导入</button></div><div id="import-results" class="admin-list"></div><hr /><label>导入 JSON 或 CSV 文件<input id="import-file" type="file" accept=".json,.csv,application/json,text/csv" /></label><div class="toolbar"><a href="/api/admin/export?format=json" download>导出 JSON</a><a href="/api/admin/export?format=csv" download>导出 CSV</a></div></div></section>
      <section data-panel="stats" hidden><div class="panel-head"><div><h1>访问统计</h1><p>页面浏览、独立访客与网站点击</p></div><select id="stats-days"><option value="1">今天</option><option value="7" selected>最近 7 天</option><option value="30">最近 30 天</option><option value="90">最近 90 天</option><option value="custom">自定义</option></select><input id="stats-start" type="date" aria-label="开始日期" /><input id="stats-end" type="date" aria-label="结束日期" /></div><div class="panel"><div id="stats-chart" class="chart"></div></div><div class="admin-grid stats-grid"><div class="panel"><h2>设备</h2><div id="device-chart" class="chart small"></div></div><div class="panel"><h2>浏览器</h2><div id="browser-chart" class="chart small"></div></div><div class="panel"><h2>操作系统</h2><div id="os-chart" class="chart small"></div></div><div class="panel"><h2>地区</h2><div id="country-chart" class="chart small"></div></div><div class="panel"><h2>访问来源</h2><div id="source-chart" class="chart small"></div></div></div></section>
      <section data-panel="settings" hidden><div class="panel-head"><div><h1>网站设置</h1><p>信息、搜索引擎展示和外观</p></div></div><form id="settings-form" class="panel settings-grid"><label>网站 URL<input name="siteUrl" type="url" required /></label><label>网站描述<textarea name="description"></textarea></label><label>SEO 标题<input name="seoTitle" /></label><label>SEO 描述<textarea name="seoDescription"></textarea></label><label>浏览器图标（favicon）<input name="favicon" placeholder="/media/icons/… 或图片 URL" /></label><div class="favicon-control"><img id="favicon-preview" src="/images/brand-lockup-black.png" width="40" height="40" alt="浏览器图标预览" /><label>上传 favicon（PNG、JPEG、WebP、ICO，最大 2 MB）<input type="file" data-upload="icons" data-target="favicon" accept=".ico,image/png,image/jpeg,image/webp,image/x-icon,image/vnd.microsoft.icon" /></label><small>上传后点击保存设置，首页和后台的浏览器图标都会更新。</small></div><label>默认主题<select name="defaultTheme"><option value="light">明亮</option><option value="dark">深色</option><option value="glass">液态玻璃</option></select></label><label>卡片布局<select name="cardLayout"><option value="comfortable">舒适</option><option value="compact">紧凑</option></select></label><label>自定义壁纸类型<select name="backgroundType"><option value="gradient">默认渐变</option><option value="color">纯色</option><option value="image">图片</option></select></label><label>壁纸颜色或图片路径<input name="backgroundValue" placeholder="上传图片后自动填写路径，纯色可填写 #RRGGBB" /></label><div id="wallpaper-preview" class="wallpaper-preview" role="img" aria-label="自定义壁纸预览"><span>壁纸预览</span></div><p class="wallpaper-help">壁纸仅用于液态玻璃主题。明亮与深色主题保持纯黑白背景。</p><label>壁纸尺寸<select name="backgroundSize"><option value="cover">Cover</option><option value="contain">Contain</option></select></label><label>壁纸位置<input name="backgroundPosition" /></label><label>壁纸模糊<input name="backgroundBlur" type="number" min="0" max="30" /></label><label>壁纸亮度<input name="backgroundBrightness" type="number" min="0.3" max="2" step="0.1" /></label><label>壁纸遮罩<input name="backgroundOverlay" type="number" min="0" max="0.8" step="0.05" /></label><div class="check-group"><label><input name="allowThemeSwitch" type="checkbox" />允许用户切换主题</label><label><input name="showDescription" type="checkbox" />显示网站描述</label><label><input name="showClickCount" type="checkbox" />显示点击量</label><label><input name="enableAnalytics" type="checkbox" />记录访问统计</label></div><div class="upload-row"><label>上传壁纸（最大 5 MB）<input type="file" data-upload="backgrounds" data-target="backgroundValue" accept="image/png,image/jpeg,image/webp" /></label></div><button id="clear-background" type="button">使用默认壁纸</button><button class="primary" type="submit">保存设置</button></form></section>
      <section data-panel="security" hidden><div class="panel-head"><div><h1>安全设置</h1><p>更改管理员密码</p></div></div><form id="password-form" class="panel form-stack narrow"><label>当前密码<input name="oldPassword" type="password" required /></label><label>新密码（至少 12 位）<input name="newPassword" type="password" minlength="12" required /></label><button class="primary" type="submit">更新密码</button></form></section>
    </main>
  </div>}
  <dialog id="edit-dialog"><form id="edit-form" class="form-stack"><div class="dialog-head"><h2 id="edit-heading">添加网址</h2><button type="button" id="edit-close" aria-label="关闭">×</button></div><div id="site-fields"><label>网址<input name="url" type="url" required /></label><button type="button" id="parse-site">解析网站</button><label>名称<input name="title" required /></label><label>简介<textarea name="description"></textarea></label><label>简短描述<input name="shortDescription" /></label><label>图标路径<input name="icon" /></label><label>OpenGraph 图片 URL<input name="ogImage" type="url" /></label><label>上传图标<input type="file" data-upload="icons" data-target="icon" accept="image/png,image/jpeg,image/webp,image/x-icon" /></label><label>一级分类<select id="site-main-category" name="mainCategoryId" required></select></label><label>二级分类<select name="categoryId" required></select></label><label>标签（逗号分隔）<input name="tags" /></label><label>排序<input name="sortOrder" type="number" min="0" max="4294967295" step="1" value="0" /><small class="sort-help">仅支持非负整数，数字越小越靠前。</small></label><div class="check-group"><label><input name="featured" type="checkbox" />推荐</label><label><input name="pinned" type="checkbox" />置顶</label><label><input name="enabled" type="checkbox" checked />启用</label></div></div><div id="category-fields" hidden><label>上级分类<select name="parentId" aria-describedby="category-parent-help"></select><small id="category-parent-help" class="sort-help">选择一级分类后，作为其顶部标签显示。</small></label><label>名称<input name="name" /></label><label>图标路径<input name="categoryIcon" /></label><label>上传分类图标<input type="file" data-upload="icons" data-target="categoryIcon" accept="image/png,image/jpeg,image/webp,image/x-icon" /></label><label>描述<textarea name="categoryDescription"></textarea></label><label>排序<input name="categorySortOrder" type="number" min="0" max="4294967295" step="1" value="0" /><small class="sort-help">仅支持非负整数，数字越小越靠前。</small></label><label class="visibility-setting"><span class="visibility-copy"><strong>在首页显示</strong><small id="category-visible-help">关闭后隐藏本分类及其网址；一级分类关闭后，其二级分类也隐藏。</small></span><span class="switch-control"><input name="visible" type="checkbox" role="switch" aria-describedby="category-visible-help" checked /><span class="switch-track" aria-hidden="true"></span></span></label></div><button class="primary" type="submit">保存</button></form></dialog>
</MainLayout>
<script src="../scripts/admin.ts"></script>






