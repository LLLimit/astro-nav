DATABASE_URL=mysql://nav:change-me@127.0.0.1:3306/nav
SITE_URL=https://nav.example.com
HOST=127.0.0.1
PORT=3000
SITE_TIMEZONE=Asia/Hong_Kong
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-random-secret
TRUST_PROXY=false
GEOIP_PROVIDER=none
GEOIP_API_URL=
GEOIP_API_KEY=
# GEOIP_PROVIDER=proxy 时，由可信的 Nginx 注入以下地理信息响应头。
