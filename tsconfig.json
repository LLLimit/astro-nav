{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "drizzle.config.ts", "scripts/**/*"],
  "exclude": ["dist", "icon-system", "src/Island"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["astro/client", "node"]
  }
}
