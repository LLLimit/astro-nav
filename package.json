    "db:import-legacy": "tsx scripts/import-legacy.ts",
    "start": "node ./scripts/start.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.1",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.3.0",
