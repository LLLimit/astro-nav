{
  "name": "astro-nav",
  "type": "module",
  "version": "1.0.0",
  "description": "Self-hosted MySQL navigation platform based on astro-xwnav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLLimit/astro-nav.git"
  },
  "keywords": [
    "astro",
    "navigation",
    "react",
    "tailwind"
  ],
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node scripts/smoke-live.mjs",
    "db:generate": "drizzle-kit generate",
