    "astro": "^5.10.0",
    "astro-seo": "^0.8.4",
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "ipaddr.js": "^2.5.0",
    "mysql2": "^3.24.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.10.0",
    "zod": "^4.6.5"
